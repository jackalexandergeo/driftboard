#!/usr/bin/env bash
# Install the helper's systemd user unit (it starts with your session) and, if there is none yet,
# a starter config. Starts nothing: the last lines say how.
set -euo pipefail
here="$(cd "$(dirname "$0")" && pwd)"
units="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
config="${XDG_CONFIG_HOME:-$HOME/.config}/driftboard-helper/config.toml"
mkdir -p "$units" "$(dirname "$config")"
# The unit's PATH: where claude, codex and python3 are now (nvm and ~/.local/bin are not on systemd's).
path=""
for tool in claude codex python3; do
    found="$(command -v "$tool" || true)"
    [ -n "$found" ] && path="$path:$(dirname "$found")"
done
path="$(printf '%s' "${path#:}:/usr/local/bin:/usr/bin:/bin" | tr ':' '\n' | awk 'NF && !seen[$0]++' | paste -sd:)"
cat > "$units/driftboard-helper.service" <<UNIT
[Unit]
Description=driftboard helper: starts AI agents (Claude Code, Codex) on board cards
Documentation=file://$here/../README.md
After=driftboard.service

[Service]
Type=simple
ExecStart=$here/bin/driftboard-helper run
Environment=PATH=$path
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
UNIT
echo "installed $units/driftboard-helper.service"
if [ ! -f "$config" ]; then
    install -m 0600 "$here/config.example.toml" "$config"
    echo "wrote $config: set agent.directory"
fi
systemctl --user daemon-reload
cat <<NEXT
Check the config:  $here/bin/driftboard-helper check
Start it:          systemctl --user enable --now driftboard-helper
Logs:              journalctl --user -fu driftboard-helper
NEXT
